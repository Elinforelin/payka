generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String
  description   String
  price         Float
  category      String
  imageUrl      String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  clasp         String?
  design        String?
  gemstone      String?
  length        Float?
  metalColor    String?
  metalStandard String?
  metalType     String?
  productType   String?
  sku           String?
  style         String?
  technology    String?
  thickness     Float?
  weight        Float?
  width         Float?
}

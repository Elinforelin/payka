# Gmail SMTP — recommended for mamenkooo@gmail.com
# Create an App Password: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mamenkooo@gmail.com
SMTP_PASS="your16chargmailapppassword"

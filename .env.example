# Production checklist
# 1. `.env` is NOT deployed with git — set these in your hosting panel OR copy `.env` to the server.
# 2. Start the app with: npm run start   (loads .env via Node's --env-file flag)
# 3. Many hosts block outbound SMTP (port 587). If email fails with ETIMEDOUT/ECONNREFUSED,
#    use Resend instead (Option 2 below) — it works over HTTPS.
#
# Option 1 — Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=mamenkooo@gmail.com
SMTP_PASS="your16chargmailapppassword"
SMTP_FROM=Payka Orders <mamenkooo@gmail.com>
ORDER_NOTIFICATION_EMAIL=mamenkooo@gmail.com

# Alternative: Resend API (https://resend.com)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM=Payka Orders <onboarding@resend.dev>

# Google Sheets — each order is appended as a new row
# Paste scripts/google-apps-script-orders.js into the sheet's Apps Script editor,
# deploy it as a web app, then put the URL and the same secret here.
GOOGLE_SHEETS_WEBHOOK_URL=
GOOGLE_SHEETS_WEBHOOK_SECRET=
